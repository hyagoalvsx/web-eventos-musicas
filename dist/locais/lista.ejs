<div class="page-header">
  <div>
    <h1 class="page-title">Consulta de Locais</h1>
    <p class="page-subtitle">Gerencie os espaços, endereços e capacidades cadastradas</p>
  </div>
  <a href="/locais/novo" class="btn btn-primary">Cadastrar Novo Local</a>
</div>

<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Nome do Local</th>
        <th>Endereço</th>
        <th>Capacidade</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if (locals.locais && locais.length > 0) { %>
        <% locais.forEach(function(local, index) { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><strong><%= local.nome %></strong></td>
            <td><%= local.endereco %></td>
            <td><span class="event-date-pill"><%= local.capacidade %></span></td>
            <td>
              <div class="actions-cell">
                <a href="/locais/<%= local.id_local %>/atualizacao" class="btn btn-outline btn-sm">Atualizar</a>
                <a
                  href="/locais/<%= local.id_local %>/excluir"
                  class="btn btn-danger-outline btn-sm"
                  onclick="return confirm('Tem certeza que deseja excluir o local <%= local.nome %>?');"
                >
                  Excluir
                </a>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="5">
            <div class="empty-state">
              <p>Nenhum local cadastrado.</p>
              <a href="/locais/novo" class="btn btn-primary btn-sm">Cadastrar primeiro local</a>
            </div>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>