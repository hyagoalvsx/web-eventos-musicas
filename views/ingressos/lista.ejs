<div class="page-header">
  <div>
    <h1 class="page-title">Consulta de Ingressos</h1>
    <p class="page-subtitle">Acompanhe tipos, preços, status e clientes por evento</p>
  </div>
  <a href="/ingressos/novo" class="btn btn-primary">Cadastrar Novo Ingresso</a>
</div>

<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Tipo</th>
        <th>Preço</th>
        <th>Status</th>
        <th>Evento</th>
        <th>Cliente</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if (locals.ingressos && ingressos.length > 0) { %>
        <% ingressos.forEach(function(ingresso, index) { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><strong><%= ingresso.tipo %></strong></td>
            <td><%= typeof currencyFormat === 'function' ? currencyFormat(ingresso.preco) : ingresso.preco %></td>
            <td><span class="event-date-pill"><%= ingresso.status %></span></td>
            <td><%= ingresso.evento ? ingresso.evento.nome : '-' %></td>
            <td><%= ingresso.cliente ? ingresso.cliente.nome : 'Sem cliente' %></td>
            <td>
              <div class="actions-cell">
                <a href="/ingressos/<%= ingresso.id_ingresso %>" class="btn btn-outline btn-sm">Atualizar</a>
                <form action="/ingressos/<%= ingresso.id_ingresso %>/excluir" method="POST" class="inline-form">
                  <button
                    type="submit"
                    class="btn btn-danger-outline btn-sm"
                    onclick="return confirm('Tem certeza que deseja excluir o ingresso #<%= ingresso.id_ingresso %>?');"
                  >
                    Excluir
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="7">
            <div class="empty-state">
              <p>Nenhum ingresso cadastrado.</p>
              <a href="/ingressos/novo" class="btn btn-primary btn-sm">Cadastrar primeiro ingresso</a>
            </div>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>