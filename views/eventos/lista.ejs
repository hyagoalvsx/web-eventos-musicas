<div class="page-header">
  <div>
    <h1 class="page-title">Consulta de Eventos</h1>
    <p class="page-subtitle">Gerencie os eventos cadastrados, datas, horários e status</p>
  </div>
  <a href="/eventos/novo" class="btn btn-primary">Cadastrar Novo Evento</a>
</div>

<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Nome do Evento</th>
        <th>Artistas</th>
        <th>Data</th>
        <th>Horário</th>
        <th>Status</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if (locals.eventos && eventos.length > 0) { %>
        <% eventos.forEach(function(evento, index) { %>
          <% const nomesArtistas = Array.isArray(evento.artistas) && evento.artistas.length > 0
               ? evento.artistas.map(function(a) { return a.nome_artistico; }).join(', ')
               : '—'; %>
          <tr>
            <td><%= index + 1 %></td>
            <td><strong><%= evento.nome %></strong></td>
            <td><%= nomesArtistas %></td>
            <td><%= typeof dateFormat === 'function' ? dateFormat(evento.data) : evento.data %></td>
            <td><%= evento.horario %></td>
            <td><span class="event-date-pill"><%= evento.status %></span></td>
            <td>
              <div class="actions-cell">
                <a href="/eventos/<%= evento.id_evento %>/atualizacao" class="btn btn-outline btn-sm">Atualizar</a>
                <a
                  href="/eventos/<%= evento.id_evento %>/excluir"
                  class="btn btn-danger-outline btn-sm"
                  onclick="return confirm('Tem certeza que deseja excluir o evento <%= evento.nome %>?');"
                >
                  Excluir
                </a>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="7">
            <div class="empty-state">
              <p>Nenhum evento cadastrado.</p>
              <a href="/eventos/novo" class="btn btn-primary btn-sm">Cadastrar primeiro evento</a>
            </div>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>