<h1 class="mt-5">Consulta de Eventos</h1>
<a href="/eventos/novo" class="btn btn-success mt-2">Cadastrar Novo Evento</a>

<table class="table mt-3">
    <thead>
        <tr>
            <th>#</th>
            <th>Nome do Evento</th>
            <th>Data</th>
            <th>Horário</th>
            <th>Status</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        <% if (locals.eventos && eventos.length > 0) { %>
            <% eventos.forEach(function(evento, index) { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><%= evento.nome %></td>
                    <td><%= evento.data %></td>
                    <td><%= evento.horario %></td>
                    <td><%= evento.status %></td>
                    <td>
                        <a href="/eventos/<%= evento.id_evento %>/atualizacao" class="btn btn-sm btn-secondary">Atualizar</a>
                        <a href="/eventos/<%= evento.id_evento %>/excluir" class="btn btn-sm btn-danger" onclick="return confirm('Tem certeza que deseja excluir o evento <%= evento.nome %>?');">Excluir</a>
                    </td>
                </tr>
            <% }) %>
        <% } else { %>
            <tr>
                <td colspan="6" class="text-center">Nenhum evento cadastrado.</td>
            </tr>
        <% } %>
    </tbody>
</table>