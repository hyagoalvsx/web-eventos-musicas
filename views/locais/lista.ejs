<h1 class="mt-5">Consulta de Locais</h1>
<a href="/locais/novo" class="btn btn-success mt-2">Cadastrar Novo Local</a>

<table class="table mt-3">
    <thead>
        <tr>
            <th>#</th>
            <th>Nome do Local</th>
            <th>Endereço</th>
            <th>Capacidade</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        <% if (locals.locais && locais.length > 0) { %>
            <% locais.forEach(function(local, index) { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><%= local.nome %></td>
                    <td><%= local.endereco %></td>
                    <td><%= local.capacidade %></td>
                    <td>
                        <a href="/locais/<%= local.id_local %>/atualizacao" class="btn btn-sm btn-secondary">Atualizar</a>
                        <a href="/locais/<%= local.id_local %>/excluir" class="btn btn-sm btn-danger" onclick="return confirm('Tem certeza que deseja excluir o local <%= local.nome %>?');">Excluir</a>
                    </td>
                </tr>
            <% }) %>
        <% } else { %>
            <tr>
                <td colspan="5" class="text-center">Nenhum local cadastrado.</td>
            </tr>
        <% } %>
    </tbody>
</table>