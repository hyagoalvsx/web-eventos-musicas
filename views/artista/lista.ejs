<div class="page-header">
  <div>
    <h1 class="page-title">Consulta de Artistas</h1>
    <p class="page-subtitle">Gerencie os artistas, nomes completos e gêneros musicais</p>
  </div>
  <a href="/artistas/novo" class="btn btn-primary">Cadastrar Novo Artista</a>
</div>

<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Nome Artístico</th>
        <th>Nome Completo</th>
        <th>Gênero Musical</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if (locals.artistas && artistas.length > 0) { %>
        <% artistas.forEach(function(artista, index) { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><strong><%= artista.nome_artistico %></strong></td>
            <td><%= artista.nome_completo %></td>
            <td><span class="event-date-pill"><%= artista.genero_musical || 'Não informado' %></span></td>
            <td>
              <div class="actions-cell">
                <a href="/artistas/<%= artista.id_artista %>/atualizacao" class="btn btn-outline btn-sm">Atualizar</a>
                <a
                  href="/artistas/<%= artista.id_artista %>/excluir"
                  class="btn btn-danger-outline btn-sm"
                  onclick="return confirm('Tem certeza que deseja excluir o artista <%= artista.nome_artistico %>?');"
                >
                  Excluir
                </a>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="5">
            <div class="empty-state">
              <p>Nenhum artista cadastrado.</p>
              <a href="/artistas/novo" class="btn btn-primary btn-sm">Cadastrar primeiro artista</a>
            </div>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>